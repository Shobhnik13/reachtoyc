# All credentials live here. Copy to .env (gitignored) and fill in.

# Postgres connection string (Neon, Supabase, local...). For a zero-setup local DB use PGlite: pglite://./.data
DATABASE_URL=pglite://./.data

# AI provider keys: set the one(s) your profiles use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: verified email lookups with Apify (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

PORT=4100

# Optional: send drafts from your own Gmail. Needs 2-step verification, then Google Account → Security → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Name shown as the sender, e.g. Shobhnik. Defaults to the Gmail account's name.
SEND_FROM_NAME=
# Random gap between sends, in seconds. The daily limit is set per profile in the app.
SEND_GAP_SECONDS=45-120
