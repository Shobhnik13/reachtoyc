# All credentials live here. Copy to .env (gitignored) and fill in.

# Postgres connection string (Neon, Supabase, local...). For a zero-setup local DB use PGlite: pglite://./.data
DATABASE_URL=pglite://./.data

# AI provider keys: set the one(s) your profiles use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: verified email lookups with Apify (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

PORT=4100
